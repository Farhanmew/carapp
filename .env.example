MONGODB_URI=
JWT_SECRET=

# Either use the single Cloudinary URL value from the Cloudinary console:
CLOUDINARY_URL=

# Or set the individual credentials below instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: folder name for uploaded dealer images
CLOUDINARY_UPLOAD_FOLDER=valuedrive/cars
